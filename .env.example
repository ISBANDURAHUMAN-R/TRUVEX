# ==============================================================================
# TruVex AI - Environment Configuration Template
# Copy this file to '.env' and populate with your settings:
#   cp .env.example .env
# ==============================================================================

# [Optional] Google Gemini API Key
# TruVex AI works 100% autonomously out of the box with heuristic & live search models.
# Providing a Gemini API key unlocks advanced LLM semantic claim synthesis.
GEMINI_API_KEY=

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Development mode (set to 1 to enable hot-reloading)
RELOAD=0

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
